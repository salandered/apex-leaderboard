# Copy to .env and adjust as needed. Filled with the compose defaults (same as running without .env file).
# Note: REDIS_URL points at the `redis` service name, reachable only from inside the compose network.

PORT=8090
UI_PORT=8089
REDIS_URL=redis://redis:6379/0
SHUTDOWN_TIMEOUT=10s
RATE_LIMIT_RPS=
RATE_LIMIT_BURST=20
LOG_LEVEL=info
LOG_FORMAT=text
LOG_FILE=
LOG_TIME=dt-milli
